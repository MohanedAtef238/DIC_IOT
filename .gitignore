# Generated certs and secrets — never commit private keys or shared secrets
certs/*.key
certs/*.crt
certs/dtls_psk.json
node_modules
.npm
certs/*.srl

# Environment variables: contains keys, passwords and tokens. Copy .env.example to .env and fill it in.
.env

# Wokwi device credentials (HiveMQ login). Copy Wokwi/secrets.example.py to Wokwi/secrets.py.
Wokwi/secrets.py

# Diagnostic dumps (may contain environment variables and tokens) and local tool caches
docs/diag/
/graft/

# SQLite database written at runtime
*.db

# Python cache
__pycache__/
*.pyc

